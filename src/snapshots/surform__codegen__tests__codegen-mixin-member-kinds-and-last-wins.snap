DEFINE TABLE OVERWRITE `post` TYPE NORMAL SCHEMAFULL;
DEFINE FIELD OVERWRITE slug ON `post` TYPE string;
DEFINE EVENT OVERWRITE touched ON `post` WHEN slug != '' THEN 1;
DEFINE FIELD OVERWRITE x ON `post` TYPE string;
DEFINE INDEX OVERWRITE slug_u ON `post` FIELDS slug;
DEFINE TABLE OVERWRITE note TYPE NORMAL SCHEMAFULL;
DEFINE FIELD OVERWRITE slug ON note TYPE string;
DEFINE FIELD OVERWRITE x ON note TYPE int;
DEFINE EVENT OVERWRITE touched ON note WHEN slug != '' THEN 1;
DEFINE INDEX OVERWRITE slug_u ON note FIELDS slug;
