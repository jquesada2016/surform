---
source: tests/info_read.rs
expression: "section_ddl(&info, section)"
---
a_aud: DEFINE ACCESS a_aud ON DATABASE TYPE JWT URL 'https://sso.example/jwks' AUDIENCE 'aud1', 'aud2' DURATION FOR SESSION 8h
a_auth: DEFINE ACCESS a_auth ON DATABASE TYPE JWT URL 'https://x.example/jwks' AUTHENTICATE $auth.admin = true DURATION FOR SESSION NONE
a_brec: DEFINE ACCESS a_brec ON DATABASE TYPE BEARER FOR RECORD DURATION FOR GRANT 4w2d, FOR TOKEN 1h, FOR SESSION NONE
a_buser: DEFINE ACCESS a_buser ON DATABASE TYPE BEARER FOR USER DURATION FOR GRANT 4w2d, FOR TOKEN 1d, FOR SESSION NONE
a_ctx: DEFINE ACCESS a_ctx ON DATABASE TYPE RECORD SIGNUP { CREATE user SET email = $email } WITH JWT ALGORITHM HS512 KEY '[REDACTED]' WITH ISSUER KEY '[REDACTED]' CONTEXT { extra: 1, tier: 'gold' } DURATION FOR TOKEN 1h, FOR SESSION NONE
a_es: DEFINE ACCESS a_es ON DATABASE TYPE JWT ALGORITHM ES256 KEY 'public_verify_pem' WITH ISSUER KEY '[REDACTED]' DURATION FOR TOKEN 1h, FOR SESSION NONE
a_hs: DEFINE ACCESS a_hs ON DATABASE TYPE JWT ALGORITHM HS256 KEY '[REDACTED]' WITH ISSUER KEY '[REDACTED]' DURATION FOR TOKEN 2h, FOR SESSION NONE
a_rec: DEFINE ACCESS a_rec ON DATABASE TYPE RECORD SIGNUP { CREATE user SET email = $email } SIGNIN { SELECT * FROM user WHERE email = $email } WITH JWT ALGORITHM HS512 KEY '[REDACTED]' WITH ISSUER KEY '[REDACTED]' DURATION FOR TOKEN 1h, FOR SESSION NONE
a_recjwt: DEFINE ACCESS a_recjwt ON DATABASE TYPE RECORD SIGNIN { SELECT id FROM user WHERE email = $email } WITH REFRESH WITH JWT ALGORITHM EDDSA KEY 'rec_signing' WITH ISSUER KEY '[REDACTED]' DURATION FOR GRANT 4w2d, FOR TOKEN 1h, FOR SESSION NONE
a_url: DEFINE ACCESS a_url ON DATABASE TYPE JWT URL 'https://sso.example/jwks' DURATION FOR SESSION 8h
a_urli: DEFINE ACCESS a_urli ON DATABASE TYPE JWT URL 'https://u.example/jwks' WITH ISSUER KEY '[REDACTED]' DURATION FOR TOKEN 1h, FOR SESSION NONE
