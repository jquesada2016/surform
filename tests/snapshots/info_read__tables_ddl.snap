---
source: tests/info_read.rs
expression: "section_ddl(&db_info, \"tables\")"
---
audit: DEFINE TABLE audit TYPE NORMAL DROP SCHEMALESS CHANGEFEED 4w2d INCLUDE ORIGINAL PERMISSIONS FULL
blobby: DEFINE TABLE blobby TYPE NORMAL SCHEMALESS PERMISSIONS NONE
cap_host: DEFINE TABLE cap_host TYPE NORMAL SCHEMALESS INLINE EDGES 64 INLINE REFERENCES 16 PERMISSIONS NONE
generic_edge: DEFINE TABLE generic_edge TYPE RELATION SCHEMALESS PERMISSIONS NONE
lw_cap: DEFINE TABLE lw_cap TYPE RELATION IN lw_users OUT lw_posts ENFORCED LIGHTWEIGHT SCHEMALESS INLINE EDGES 8 PERMISSIONS NONE
lw_likes: DEFINE TABLE lw_likes TYPE RELATION IN lw_users OUT lw_posts ENFORCED LIGHTWEIGHT SCHEMALESS PERMISSIONS NONE
lw_posts: DEFINE TABLE lw_posts TYPE NORMAL SCHEMALESS PERMISSIONS NONE
lw_users: DEFINE TABLE lw_users TYPE NORMAL SCHEMALESS PERMISSIONS NONE
orgs: DEFINE TABLE orgs TYPE NORMAL SCHEMALESS PERMISSIONS NONE
out: DEFINE TABLE out TYPE NORMAL SCHEMALESS PERMISSIONS NONE
post_stats: DEFINE TABLE post_stats TYPE ANY SCHEMALESS COMMENT 'Posts per author' AS SELECT author, count() AS posts FROM posts GROUP BY author PERMISSIONS NONE
posts: DEFINE TABLE posts TYPE NORMAL SCHEMALESS PERMISSIONS NONE
rel_out: DEFINE TABLE rel_out TYPE RELATION IN out OUT posts SCHEMALESS PERMISSIONS NONE
users: DEFINE TABLE users TYPE NORMAL SCHEMAFULL COMMENT 'App users' PERMISSIONS FOR select, create FULL, FOR update WHERE $auth.id = id, FOR delete NONE
users2: DEFINE TABLE users2 TYPE NORMAL SCHEMALESS PERMISSIONS NONE
wrote: DEFINE TABLE wrote TYPE RELATION IN users2 | orgs OUT posts ENFORCED SCHEMALESS PERMISSIONS NONE
