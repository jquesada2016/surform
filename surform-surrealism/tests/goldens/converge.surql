USE NS s2demo DB probe;

-- ------------------------------------------------------------
-- ## Scope db:s2demo/probe
-- section: db:s2demo/probe (2 defines, 2 removals)

BEGIN TRANSACTION;

-- ------------------------------------------------------------
-- ## Defines - the state the schema file describes
--
-- Each define carries OVERWRITE: a re-run redefines it.

DEFINE PARAM OVERWRITE $retention VALUE 30;
DEFINE TABLE OVERWRITE audit TYPE NORMAL SCHEMAFULL;
DEFINE FIELD OVERWRITE `at` ON audit TYPE datetime;

-- ------------------------------------------------------------
-- ## Removals - objects the schema file no longer declares
--
-- Each removal is idempotent (IF EXISTS): a re-run skips it.

-- >>> SURFORM REQUIRED: DATA MIGRATION <<<
-- Removes field note on table user. The stored values remain
--    on the rows, outside every field definition.
-- - Write the move query between the markers; it runs before
--   the removal, in this same transaction.
-- e.g. UPDATE `user` SET moved = note;
-- - The values remain after this script; unset them once the
--   copy is verified (e.g. UPDATE `user` UNSET note;).
-- >>> SURFORM REQUIRED: END <<<
REMOVE FIELD IF EXISTS note ON `user`;

-- >>> SURFORM WARNING: DATA LOSS <<<
-- Removes table legacy - every document in it is deleted.

-- >>> SURFORM REQUIRED: DATA MIGRATION <<<
-- - Write the export, archive, or move query between the
--   markers; it runs before the removal, in this same
--   transaction.
-- e.g. INSERT INTO archive (SELECT * FROM legacy);
-- >>> SURFORM REQUIRED: END <<<
REMOVE TABLE IF EXISTS legacy;

COMMIT;
