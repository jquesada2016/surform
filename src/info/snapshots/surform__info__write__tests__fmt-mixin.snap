// shared audit columns
mixin timestamped {
  field created_at: datetime;
  field updated_at: datetime {
    default: time::now();
  };
};

table `post` {
  schemafull;
  ...timestamped; // audit trail
  field title: string;
  field created_at: datetime; // overrides the member
};
