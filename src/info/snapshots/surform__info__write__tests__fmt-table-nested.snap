---
source: src/info/write.rs
expression: once
---
/// Application users
table `user` {
  schemafull;
  permissions {
    select: $auth.id != NONE;
    delete: $auth.admin = true;
  };
  field email: string {
    default: 'unknown@example.com';
    assert: string::is_email($value);
  };
  field display_name = string::uppercase(email);
  index unique one_email {
    fields: email;
  };
  event audited {
    when: $event = 'UPDATE';
    then: (CREATE audit SET who = $auth.id);
  };
};
