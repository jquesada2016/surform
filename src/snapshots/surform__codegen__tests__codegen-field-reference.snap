DEFINE FIELD OVERWRITE comics ON person TYPE option<array<record<comic_book>>> REFERENCE;
DEFINE FIELD OVERWRITE author ON `post` TYPE record<user> REFERENCE ON DELETE CASCADE;
DEFINE FIELD OVERWRITE parent ON page TYPE record<page>
    REFERENCE ON DELETE THEN { CREATE cleanup_log SET at = time::now() };
