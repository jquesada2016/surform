DEFINE ACCESS OVERWRITE member ON DATABASE
    TYPE RECORD
    SIGNIN {
        SELECT id FROM user WHERE email = $email AND crypto::argon2::compare(password, $password)
    }
    WITH REFRESH
    WITH JWT ALGORITHM EDDSA KEY 'member_signing_key' WITH ISSUER KEY '[REDACTED]';
